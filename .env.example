APP_NAME=PayGate
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://paygate:paygate@localhost:5433/paygate
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
FRAUD_THRESHOLD=0.8
FRAUD_MODEL_PATH=artifacts/fraud_model.joblib
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_DELAY_SECONDS=1
WEBHOOK_MAX_DELAY_SECONDS=300
WEBHOOK_TIMEOUT_SECONDS=10
API_KEY_PREFIX=pg_live_
CURSOR_DEFAULT_LIMIT=20
CURSOR_MAX_LIMIT=100
LOG_LEVEL=INFO
SEED_DEMO=true
